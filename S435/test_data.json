    "mock": {"v2": {"mode": "requiresAuth", "initial_status": "pending_auth", "transactionId": "T890", "final_webhook": {"status": "authorized", "fraudScore": 8}}},
    "expected": {"final_status": "authorized", "transactionId": "T890", "fraudScore": 8}
  },
  {
    "id": "TC3-async-confirm",
    "description": "Async confirmation: v2 initial pending status; webhook later returns success.",
    "input": {"orderId": "O125", "amount": 2000, "paymentMethod": "card", "currency": "EUR", "countryCode": "DE", "threeDS": null},
    "mock": {"v2": {"mode": "async_pending", "initial_status": "pending", "transactionId": "T901", "final_webhook": {"status": "authorized", "fraudScore": 4}, "delay_seconds": 2}},
    "expected": {"final_status": "authorized", "transactionId": "T901", "fraudScore": 4}
  },
  {
    "id": "TC4-v2-error-fallback",
