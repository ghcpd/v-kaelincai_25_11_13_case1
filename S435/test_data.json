    "input": {"orderId": "O126", "amount": 500, "paymentMethod": "card", "currency": "USD", "countryCode": "US", "threeDS": null},
    "mock": {"v2": {"mode": "error", "status_code": 500, "timeout": true}, "v1": {"mode": "sync", "status": "authorized"}},
    "expected": {"final_status": "authorized", "transactionId": "V1-T-123", "fallback_used": true}
  },
